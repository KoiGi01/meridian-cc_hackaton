{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter pointto-core --filter pointto build && pnpm --filter finefoods-antd exec vite build",
  "outputDirectory": "examples/demo-app/dist",
  "framework": null,
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
